# pages/1_⚾_MLB_Analytics.py
from core_engine import (
    american_to_decimal,
    calculate_kelly,
    decimal_to_american,
    fetch_live_odds,
    strip_vig,
)
import pandas as pd
import streamlit as st

st.set_page_config(page_title="MLB Analytics", page_icon="⚾", layout="wide")
st.title("⚾ MLB Quantitative Engine")

bankroll = st.session_state.get("bankroll", 1000.0)

tab_scanner, tab_devig, tab_notes = st.tabs(
    ["📊 Run Line & ML Scanner", "🎯 Fair Price & Kelly", "🧠 MLB Factors"]
)

with tab_scanner:
    st.subheader("MLB Discrepancy & Arbitrage Finder")

    demo_data = [
        {
            "Matchup": "NY Yankees @ BOS Red Sox",
            "Market": "Moneyline",
            "DraftKings": (-112, -108),
            "FanDuel": (-105, -115),
            "BetMGM": (-118, +100),
        },
        {
            "Matchup": "LA Dodgers @ SD Padres",
            "Market": "Run Line (-1.5 / +1.5)",
            "DraftKings": (+142, -170),
            "FanDuel": (+150, -182),
            "BetMGM": (+138, -165),
        },
    ]

    table_rows = []
    for game in demo_data:
        # Find best away and home decimal odds
        away_options = [
            ("DraftKings", game["DraftKings"][0]),
            ("FanDuel", game["FanDuel"][0]),
            ("BetMGM", game["BetMGM"][0]),
        ]
        home_options = [
            ("DraftKings", game["DraftKings"][1]),
            ("FanDuel", game["FanDuel"][1]),
            ("BetMGM", game["BetMGM"][1]),
        ]

        best_away = max(away_options, key=lambda x: american_to_decimal(x[1]))
        best_home = max(home_options, key=lambda x: american_to_decimal(x[1]))

        imp_a = 1.0 / american_to_decimal(best_away[1])
        imp_h = 1.0 / american_to_decimal(best_home[1])
        combined = (imp_a + imp_h) * 100

        table_rows.append(
            {
                "Matchup": game["Matchup"],
                "Market": game["Market"],
                "Best Away": f"{best_away[0]} ({best_away[1]:+d})",
                "Best Home": f"{best_home[0]} ({best_home[1]:+d})",
                "Combined Implied %": f"{combined:.2f}%",
                "Status": (
                    f"🔥 ARB (+{100-combined:.2f}%)"
                    if combined < 100
                    else "Normal Margin"
                ),
            }
        )

    st.dataframe(pd.DataFrame(table_rows), use_container_width=True)

with tab_devig:
    st.subheader("MLB De-Vig & Sizing")
    c1, c2 = st.columns(2)
    with c1:
        away_line = st.number_input("Away Team Odds", value=+145, step=5)
    with c2:
        home_line = st.number_input("Home Team Odds", value=-170, step=5)

    vig, p_away, p_home = strip_vig(
        american_to_decimal(away_line), american_to_decimal(home_line)
    )
    st.metric("Sportsbook Vig", f"{vig:.2f}%")

    col_a, col_b = st.columns(2)
    col_a.metric("Fair Away Win %", f"{p_away*100:.2f}%")
    col_b.metric("Fair Home Win %", f"{p_home*100:.2f}%")

    st.divider()
    soft_line = st.number_input(
        "Offered Line on Soft Book for Away", value=+155, step=5
    )
    ev, stake = calculate_kelly(
        bankroll, p_away, american_to_decimal(soft_line), fraction=0.25
    )
    st.metric("Expected Value (EV%)", f"{ev:+.2f}%")
    st.metric("Recommended Quarter-Kelly Wager", f"${stake:.2f}")

with tab_notes:
    st.markdown("""
    * **Run Lines are standard at 1.5 runs:** Baseball spreads rarely fluctuate in points—instead, books move the juice significantly (e.g. from -140 to -175).
    * **Action vs Listed Pitchers:** Always confirm your book's terms for pitching substitutions.
    """)